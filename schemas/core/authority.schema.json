{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:meaningwire:schema:core:authority:0.1.0",
  "title": "MeaningWire Authority",
  "description": "Authority and approval metadata kept separate from canonical data content.",
  "x-meaningwire-contract-version": "0.1.0",
  "x-meaningwire-maturity": "EXPERIMENTAL",
  "type": "object",
  "additionalProperties": false,
  "required": ["kind", "approval"],
  "properties": {
    "kind": {"type": "string", "enum": ["source_authority", "human_authority", "system_authority", "model_inference", "none"]},
    "actor": {"$ref": "urn:meaningwire:schema:core:reference:0.1.0"},
    "scope": {"type": "array", "items": {"type": "string", "minLength": 1}, "uniqueItems": true},
    "approval": {"type": "string", "enum": ["approved", "rejected", "not_asserted"]},
    "basis": {"type": "string", "minLength": 1},
    "confidence": {"type": "number", "minimum": 0, "maximum": 1}
  },
  "allOf": [
    {
      "if": {"properties": {"kind": {"const": "human_authority"}}, "required": ["kind"]},
      "then": {"required": ["actor"]},
      "else": {"properties": {"approval": {"const": "not_asserted"}}}
    },
    {
      "if": {"properties": {"kind": {"const": "model_inference"}}, "required": ["kind"]},
      "then": {"required": ["confidence"]}
    }
  ]
}
